<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nt_bg_candy"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingTop="6dp"
    android:paddingRight="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/nt_art"
            android:layout_width="50dp"
            android:layout_height="46dp"
            android:scaleType="fitCenter"
            android:src="@drawable/nt_art_candy" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/nt_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="READING"
                    android:textColor="#FFC2E0"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <Chronometer
                    android:id="@+id/nt_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:textColor="#FFFFFF"
                    android:alpha="0.8"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/nt_paused"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:textColor="#FFFFFF"
                    android:alpha="0.8"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
            <TextView
                android:id="@+id/nt_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/nt_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.9"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
                <ProgressBar
                    android:id="@+id/nt_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progressDrawable="@drawable/nt_bar_candy" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/nt_btn_pause"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/nt_pill_candy"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/nt_ico_pause"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_pause" />
            <TextView
                android:id="@+id/nt_txt_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:maxLines="1"
                android:text="Pause"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nt_btn_stop"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/nt_pill_candy"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/nt_ico_stop"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_stop" />
            <TextView
                android:id="@+id/nt_txt_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:maxLines="1"
                android:text="Stop"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/nt_btn_discard"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/nt_pill_candy"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/nt_ico_discard"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_discard" />
            <TextView
                android:id="@+id/nt_txt_discard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:maxLines="1"
                android:text="Discard"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
