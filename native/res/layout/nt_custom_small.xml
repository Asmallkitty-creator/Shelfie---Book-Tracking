<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/nt_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/nt_art"
                android:layout_width="104dp"
                android:layout_height="58dp"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/nt_div"
                android:layout_width="1dp"
                android:layout_height="58dp"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:background="#44FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nt_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.12"
                        android:text="READING"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <Chronometer
                        android:id="@+id/nt_chrono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/nt_paused"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/nt_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:maxLines="1"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/nt_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/nt_chip_w"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingLeft="10dp"
                    android:paddingTop="2dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="2dp"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/nt_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:max="100" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/nt_btn_pause"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:background="@drawable/nt_pill_w"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/nt_ico_pause"
                    android:layout_width="14dp"
                    android:layout_height="14dp" />

                <TextView
                    android:id="@+id/nt_txt_pause"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="Pause"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/nt_btn_stop"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginRight="6dp"
                android:layout_weight="1"
                android:background="@drawable/nt_pill_w"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/nt_ico_stop"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_stop" />

                <TextView
                    android:id="@+id/nt_txt_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="Stop"
                    android:textSize="11sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/nt_btn_discard"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_marginRight="0dp"
                android:layout_weight="1"
                android:background="@drawable/nt_pill_w"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/nt_ico_discard"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_discard" />

                <TextView
                    android:id="@+id/nt_txt_discard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:text="Discard"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
