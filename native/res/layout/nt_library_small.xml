<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/nt_bg_library"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingTop="8dp"
    android:paddingRight="10dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/nt_art"
        android:layout_width="58dp"
        android:layout_height="54dp"
        android:scaleType="fitCenter"
        android:src="@drawable/nt_art_library" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/nt_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="READING"
                    android:textColor="#F5A64A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <Chronometer
                    android:id="@+id/nt_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:textColor="#FFF0DC"
                    android:alpha="0.8"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/nt_paused"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:textColor="#FFF0DC"
                    android:alpha="0.8"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        <TextView
            android:id="@+id/nt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:textColor="#FFF0DC"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/nt_chip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.85"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFF0DC"
            android:textSize="12sp" />
        <ProgressBar
            android:id="@+id/nt_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:max="100"
            android:progressDrawable="@drawable/nt_bar_library" />
    </LinearLayout>

    <ImageView
        android:id="@+id/nt_c_pause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="8dp"
        android:background="@drawable/nt_pill_library"
        android:padding="10dp"
        android:src="@drawable/ic_pause" />
</LinearLayout>
